-#define JS_INTERRUPT_COUNTER_INIT 10000
+/* RPG2LX: 1000 instead of 10000, so the sampling profiler sees every ~0.1 ms of
+   JS on a handheld; the handler only reads a clock when it has nothing to do. */
+#define JS_INTERRUPT_COUNTER_INIT 1000
 
 struct JSContext {
     JSGCObjectHeader header; /* must come first */
@@ -8157,6 +8159,35 @@ static const char *get_func_name(JSContext *ctx, JSValueConst func)
     return JS_ToCString(ctx, val);
 }
 
+/* RPG2LX: "name (file:line)" of the level-th stack frame (0 = the running
+   function), for RPG2LX's sampling profiler. The line is where the function
+   is defined: the running frame's pc is only saved at calls, so the line
+   being executed is not known. Returns -1 when there is no such frame. */
+int JS_GetStackFrameInfo(JSContext *ctx, int level, char *buf, size_t size)
+{
+    JSStackFrame *sf;
+    JSObject *p;
+    const char *name, *file;
+
+    for (sf = ctx->rt->current_stack_frame; sf && level > 0; sf = sf->prev_frame)
+        level--;
+    if (!sf || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT || size == 0)
+        return -1;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    name = get_func_name(ctx, sf->cur_func);
+    if (js_class_has_bytecode(p->class_id)) {
+        JSFunctionBytecode *b = p->u.func.function_bytecode;
+        file = b->filename ? JS_AtomToCString(ctx, b->filename) : NULL;
+        snprintf(buf, size, "%s (%s:%d)", name && name[0] ? name : "<anonymous>",
+                 file ? file : "?", b->line_num);
+        JS_FreeCString(ctx, file);
+    } else {
+        snprintf(buf, size, "%s (native)", name && name[0] ? name : "<anonymous>");
+    }
+    JS_FreeCString(ctx, name);
+    return 0;
+}
+
 /* Note: it is important that no exception is returned by this function */

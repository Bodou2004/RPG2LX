+/* RPG2LX: legacy RegExp statics. magic 1-9: $1-$9, 0: lastMatch,
+   10: input, 11: leftContext, 12: rightContext, 13: lastParen. */
+static JSValue js_regexp_get_legacy(JSContext *ctx, JSValueConst this_val, int magic)
+{
+    JSValue m = ctx->regexp_last_match, v, input;
+    int64_t len, index;
+    JSString *s;
+    if (!JS_IsObject(m))
+        return JS_AtomToString(ctx, JS_ATOM_empty_string);
+    if (magic <= 9 || magic == 13) {
+        uint32_t i = magic;
+        if (magic == 13) {
+            if (js_get_length64(ctx, &len, m))
+                return JS_EXCEPTION;
+            i = len > 1 ? (uint32_t)(len - 1) : 0;
+            if (len <= 1)
+                return JS_AtomToString(ctx, JS_ATOM_empty_string);
+        }
+        v = JS_GetPropertyUint32(ctx, m, i);
+        if (JS_IsUndefined(v))
+            return JS_AtomToString(ctx, JS_ATOM_empty_string);
+        return v;
+    }
+    input = JS_GetProperty(ctx, m, JS_ATOM_input);
+    if (magic == 10 || !JS_IsString(input))
+        return input;
+    v = JS_GetProperty(ctx, m, JS_ATOM_index);
+    if (JS_ToInt64Free(ctx, &index, v)) {
+        JS_FreeValue(ctx, input);
+        return JS_EXCEPTION;
+    }
+    s = JS_VALUE_GET_STRING(input);
+    if (magic == 11) {
+        v = js_sub_string(ctx, s, 0, (int)index);
+    } else {
+        JSValue whole = JS_GetPropertyUint32(ctx, m, 0);
+        int end = (int)index;
+        if (JS_IsString(whole))
+            end += JS_VALUE_GET_STRING(whole)->len;
+        JS_FreeValue(ctx, whole);
+        v = js_sub_string(ctx, s, end, s->len);
+    }
+    JS_FreeValue(ctx, input);
+    return v;
+}
